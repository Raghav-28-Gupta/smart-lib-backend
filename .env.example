# Copy to backend/.env and fill in. The real .env is never committed.
# In production (Render), these are set as environment variables instead.

# Postgres with the btree_gist extension (Neon has it). Use the DIRECT
# connection string, not the "-pooler" one: migrations take advisory locks
# that a transaction pooler breaks. The pg driver treats sslmode=require as
# verify-full anyway (and warns); writing verify-full says so without the warning.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# A separate database for `npm test`, which empties every table it touches.
# Never point this at a database whose data you want to keep.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME_test?sslmode=verify-full

# Signs login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it logs everyone out.
JWT_SECRET=

# The internal AI service. Unreachable is fine: recommendations fall back to
# what's popular in the library.
AI_BACKEND_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API. Empty allows any
# origin (local development). Production: the web app's origin, e.g.
#   CORS_ORIGINS=https://raghav-28-gupta.github.io
CORS_ORIGINS=

PORT=3000
