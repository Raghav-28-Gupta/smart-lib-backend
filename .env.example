# Copy to backend/.env and fill in. The real .env is never committed.
# In production (Render), these are set as environment variables instead.

# Postgres with the btree_gist extension (Neon has it). Use the DIRECT
# connection string, not the "-pooler" one: migrations take advisory locks
# that a transaction pooler breaks. The pg driver treats sslmode=require as
# verify-full anyway (and warns); writing verify-full says so without the warning.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# A separate database for `npm test`, which empties every table it touches.
# Never point this at a database whose data you want to keep.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME_test?sslmode=verify-full

# Signs login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it logs everyone out.
JWT_SECRET=

# The internal AI service. Setting it also turns no-show scoring ON: every new
# booking then asks the service for a no-show probability (2-second timeout), so
# with no service running, each booking logs "not scored" and nothing else
# happens. Blank or unset means no no-show call at all (scoring stays off, as in
# production today). Unreachable is fine either way: recommendations fall back
# to what's popular in the library, and a booking that is not scored simply gets
# no priority nudge.
AI_BACKEND_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API. Empty allows any
# origin (local development). Production: the web app's origin, e.g.
#   CORS_ORIGINS=https://raghav-28-gupta.github.io,https://<admin console>.vercel.app
CORS_ORIGINS=

# Email (overdue reminders, dispute and problem-report outcomes) goes through
# Brevo's transactional email API. It is OFF unless BREVO_API_KEY and MAIL_FROM
# are both set; the app and the in-app notices work the same without it. The key
# is a secret: set it only as an environment variable (on Render, or in your own
# untracked .env), never in a committed file. Tests never send email.
# BREVO_API_KEY=
# The sender address (a Brevo-verified sender) and its display name.
# MAIL_FROM=
# MAIL_FROM_NAME=SmartLib
# Optional, comma-separated: when set, only addresses at these domains receive
# mail and every other address is skipped. Unset means every address except the
# demo accounts the seed creates.
# MAIL_ALLOWED_DOMAINS=thapar.edu

# No-show sweep. A scheduled workflow calls POST /internal/sweep with this token in
# the x-sweep-token header to record missed bookings and send reminders. The
# endpoint is OFF (404) unless this is set, and the sweep still runs on its own
# when anyone opens My Bookings or the console's Bookings page. A secret: use a
# long random string, set it only as an environment variable (on Render, and as
# the repo secret SWEEP_TOKEN), never in a committed file. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SWEEP_TOKEN=

# Production (Render) must set TZ=Asia/Kolkata: days and booking slots use the
# server's time zone. Local machines already run in their own zone.
# TZ=Asia/Kolkata

PORT=3000
