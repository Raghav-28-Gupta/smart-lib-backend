// Prisma 7: the `prisma-client` generator emits into an explicit output dir
// (no more node_modules/.prisma), and the datasource URL now lives in
// prisma.config.ts rather than an env() call here.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The backend compiles to CommonJS, and compiled output keeps import
  // specifiers as written. Left to infer, the generator emits ES modules
  // (import.meta.url) importing './x.ts' -- which tsx and vitest tolerate,
  // but compiled `node dist/index.js` (production) crashes on at startup.
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  admin
}

enum CopyStatus {
  available
  borrowed
  lost
  maintenance
  // Set aside for a pending borrow request (see BorrowRequest).
  requested
}

enum LoanStatus {
  active
  returned
  overdue
  // Closed because the copy was marked lost: not returned, not overdue.
  lost
}

enum ReservationStatus {
  waiting
  fulfilled
  expired
  cancelled
}

enum ResourceType {
  seat
  room
}

enum ResourceStatus {
  available
  // Offline means "no new bookings"; bookings that already exist stay.
  offline
}

enum BookingStatus {
  booked
  checked_in
  no_show
  released
  completed
  cancelled
  // A room booking waiting for a librarian, and its two unhappy endings.
  requested
  declined
  expired
}

enum BorrowRequestStatus {
  pending
  approved
  declined
  expired
  cancelled
}

enum FineReason {
  overdue
  no_show
  // A replacement charge for a lost book.
  lost
}

enum FineStatus {
  // Owed and never adjusted. The admin API calls it "outstanding".
  pending
  paid
  waived
  // Owed, with the amount lowered by a librarian (see Fine.originalAmount).
  adjusted
}

enum RecommendationMethod {
  content
  collaborative
  hybrid
}

enum NoticeKind {
  overdue_reminder
  overdue_escalation
  dispute_outcome
  report_outcome
  // Booking notices: a "starts soon" reminder, a recorded no-show, and the answer
  // to a student's dispute of one (they carry Notice.bookingId).
  booking_reminder
  no_show
  no_show_outcome
}

// Where a fine dispute stands. `open` while the librarians have not answered;
// the other three say how it was settled: the fine waived, lowered, or kept.
enum DisputeStatus {
  open
  waived
  adjusted
  upheld
}

// Where a no-show dispute stands. `open` while the librarians have not answered;
// `overturned` means the no-show was removed (the booking goes back to `released`
// and the points are restored), `upheld` that it stands.
enum NoShowDisputeStatus {
  open
  overturned
  upheld
}

// What a student says is wrong. `damaged` and `missing_pages` are for a book copy
// (reported when it is returned), `not_working` and `dirty` for a seat or room;
// `other` is for either and needs a note.
enum IssueCategory {
  damaged
  missing_pages
  not_working
  dirty
  other
}

// Where a problem report stands. `open` until a librarian answers it; the other
// two say the library acted on it (`confirmed`) or found nothing to do (`dismissed`).
enum ReportStatus {
  open
  confirmed
  dismissed
}

// What happened when the library tried to email a notice. `skipped` is also
// the default a notice is written with, and the final answer when email is not
// set up or the address is a placeholder: nothing was attempted.
enum EmailStatus {
  sent
  failed
  skipped
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  // University roll number. Nullable because self-registered accounts don't
  // supply one; the API surfaces `roll ?? 'Pending'` to the client.
  roll             String?
  role             Role     @default(student)
  reliabilityScore Float    @default(100)
  createdAt        DateTime @default(now())

  loans           Loan[]
  reservations    Reservation[]
  bookings        ResourceBooking[]     @relation("BookingUser")
  fines           Fine[]
  reliabilityLogs ReliabilityScoreLog[]
  recommendations RecommendationCache[]

  borrowRequests         BorrowRequest[]       @relation("BorrowRequester")
  decidedBorrowRequests  BorrowRequest[]       @relation("BorrowRequestDecider")
  decidedBookings        ResourceBooking[]     @relation("BookingDecider")
  cancelledBookings      ResourceBooking[]     @relation("BookingCanceller")
  adjustedFines          Fine[]                @relation("FineAdjuster")
  recordedFinePayments   Fine[]                @relation("FinePaymentRecorder")
  adjustedReliability    ReliabilityScoreLog[] @relation("ReliabilityAdjuster")
  notices                Notice[]              @relation("NoticeRecipient")
  authoredNotices        Notice[]              @relation("NoticeAuthor")
  fineDisputes           FineDispute[]         @relation("DisputeStudent")
  resolvedFineDisputes   FineDispute[]         @relation("DisputeResolver")
  issueReports           IssueReport[]         @relation("ReportAuthor")
  resolvedIssueReports   IssueReport[]         @relation("ReportResolver")
  noShowDisputes         NoShowDispute[]       @relation("NoShowDisputeStudent")
  resolvedNoShowDisputes NoShowDispute[]       @relation("NoShowDisputeResolver")
}

model Book {
  id            String  @id @default(uuid())
  isbn          String  @unique
  title         String
  author        String
  genre         String?
  description   String?
  publishedYear Int?
  // No longer read: a book's total is counted from its copies that are not lost
  // (bookService.totalCopiesByBook). Kept so the seed and older rows still load.
  totalCopies   Int     @default(1)

  copies          BookCopy[]
  reservations    Reservation[]
  recommendations RecommendationCache[]
  borrowRequests  BorrowRequest[]
}

model BookCopy {
  id      String     @id @default(uuid())
  bookId  String
  book    Book       @relation(fields: [bookId], references: [id])
  status  CopyStatus @default(available)
  loans   Loan[]
  // Handed out by the database (migration console_catalogue: next_copy_barcode()),
  // SL-00001 and up, so every way of adding a copy gets one.
  barcode String     @unique @default(dbgenerated("next_copy_barcode()"))

  borrowRequests BorrowRequest[]
  issueReports   IssueReport[]
}

model Loan {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  bookCopyId   String
  bookCopy     BookCopy   @relation(fields: [bookCopyId], references: [id])
  borrowedAt   DateTime   @default(now())
  dueAt        DateTime
  returnedAt   DateTime?
  // When a librarian marked the copy lost while this loan was open.
  lostAt       DateTime?
  renewedCount Int        @default(0)
  status       LoanStatus @default(active)
  fines        Fine[]

  borrowRequest BorrowRequest?
  notices       Notice[]
}

model Reservation {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  bookId         String
  book           Book              @relation(fields: [bookId], references: [id])
  requestedAt    DateTime          @default(now())
  status         ReservationStatus @default(waiting)
  claimExpiresAt DateTime?
}

model Resource {
  id         String         @id @default(uuid())
  type       ResourceType
  name       String
  location   String?
  capacity   Int            @default(1)
  status     ResourceStatus @default(available)
  // The optional note given when a librarian takes the resource offline.
  statusNote String?

  bookings     ResourceBooking[]
  issueReports IssueReport[]
}

model ResourceBooking {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation("BookingUser", fields: [userId], references: [id])
  resourceId         String
  resource           Resource      @relation(fields: [resourceId], references: [id])
  // Timestamptz, not plain timestamp: the no_overlapping_bookings EXCLUDE
  // constraint indexes tstzrange(startTime, endTime), and tstzrange() is only
  // IMMUTABLE (a hard requirement for index expressions) when its arguments
  // are already timestamptz. Absolute instants are the right model for
  // bookings regardless.
  startTime          DateTime      @db.Timestamptz(3)
  endTime            DateTime      @db.Timestamptz(3)
  status             BookingStatus @default(booked)
  gracePeriodMinutes Int           @default(15)
  checkedInAt        DateTime?     @db.Timestamptz(3)
  priorityScore      Float?
  // Approval of room bookings (seats are booked directly). requestedAt is
  // when the student asked; decidedAt when the row left 'requested'
  // (approved, declined, expired or withdrawn); decidedBy the librarian who
  // approved or declined.
  requestedAt        DateTime      @default(now()) @db.Timestamptz(3)
  decidedAt          DateTime?     @db.Timestamptz(3)
  decidedById        String?
  decidedBy          User?         @relation("BookingDecider", fields: [decidedById], references: [id])
  declineReason      String?
  // A librarian's cancel. A booking is library-cancelled exactly when
  // cancelledById is set; a student's own cancel leaves all three null.
  cancelledAt        DateTime?     @db.Timestamptz(3)
  cancelledById      String?
  cancelledBy        User?         @relation("BookingCanceller", fields: [cancelledById], references: [id])
  cancelReason       String?
  // A librarian's reassign: the name of the resource the booking was moved
  // from, and when.
  movedFromName      String?
  movedAt            DateTime?     @db.Timestamptz(3)
  // When the "starts soon" reminder was written. Set once, by the sweep's
  // conditional update, so a booking is reminded at most once.
  reminderSentAt     DateTime?     @db.Timestamptz(3)

  noShowEvent   NoShowEvent?
  noShowDispute NoShowDispute?
  fines         Fine[]
  notices       Notice[]

  @@index([status, startTime])
  @@index([startTime])
}

// A student's request to borrow a book, waiting for a librarian. The copy it
// holds is set to CopyStatus.requested until the request is decided, lapses
// or is withdrawn; approval creates the Loan. One pending request per student
// and title is enforced by a partial unique index in the migration SQL
// (Prisma's schema language cannot express a WHERE clause on an index).
model BorrowRequest {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation("BorrowRequester", fields: [userId], references: [id])
  bookId        String
  book          Book                @relation(fields: [bookId], references: [id])
  bookCopyId    String
  bookCopy      BookCopy            @relation(fields: [bookCopyId], references: [id])
  status        BorrowRequestStatus @default(pending)
  requestedAt   DateTime            @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime            @db.Timestamptz(3)
  decidedAt     DateTime?           @db.Timestamptz(3)
  decidedById   String?
  decidedBy     User?               @relation("BorrowRequestDecider", fields: [decidedById], references: [id])
  declineReason String?
  loanId        String?             @unique
  loan          Loan?               @relation(fields: [loanId], references: [id])

  @@index([status, expiresAt])
}

model NoShowEvent {
  id                   String          @id @default(uuid())
  resourceBookingId    String          @unique
  resourceBooking      ResourceBooking @relation(fields: [resourceBookingId], references: [id])
  userId               String
  // Null when the booking was never scored (the AI service was down or slow): the
  // sweep still records the no-show.
  predictedProbability Float?
  actualNoShow         Boolean?
  // The reliability points the no-show actually took (negative, after the clamp
  // to [0, 100]), so an overturn gives back exactly that. Null until a penalty.
  reliabilityDelta     Float?
  recordedAt           DateTime        @default(now())
}

model Fine {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  relatedLoanId    String?
  relatedLoan      Loan?            @relation(fields: [relatedLoanId], references: [id])
  relatedBookingId String?
  relatedBooking   ResourceBooking? @relation(fields: [relatedBookingId], references: [id])
  amount           Float
  reason           FineReason
  status           FineStatus       @default(pending)
  createdAt        DateTime         @default(now())
  // What the fine was before a librarian lowered it: set by the first
  // adjustment and kept through later ones. Null means never adjusted.
  originalAmount   Float?
  // The latest adjustment or waive: when, by whom (null if the account is
  // gone), and why.
  adjustedAt       DateTime?
  adjustedById     String?
  adjustedBy       User?            @relation("FineAdjuster", fields: [adjustedById], references: [id], onDelete: SetNull)
  adjustReason     String?
  // Payment: when it was recorded and by which librarian (null if the account
  // is gone).
  paidAt           DateTime?
  paidRecordedById String?
  paidRecordedBy   User?            @relation("FinePaymentRecorder", fields: [paidRecordedById], references: [id], onDelete: SetNull)
  // The marker for an open dispute: set when the student disputes the fine,
  // cleared when a librarian resolves it. Paying, adjusting and disputing are all
  // conditional updates on this row, so whichever commits first wins and the
  // others find the marker (or the status) changed.
  disputedAt       DateTime?

  notices Notice[]
  dispute FineDispute?

  @@index([createdAt])
}

// A student's dispute of one fine: why they think it is wrong, and how the
// library answered. At most one per fine, ever (the unique fineId), open or
// resolved. While it is open the fine carries disputedAt and cannot be paid.
model FineDispute {
  id             String        @id @default(uuid())
  fineId         String        @unique
  fine           Fine          @relation(fields: [fineId], references: [id])
  userId         String
  user           User          @relation("DisputeStudent", fields: [userId], references: [id])
  reason         String
  status         DisputeStatus @default(open)
  resolutionNote String?
  // The librarian who resolved it (null while open, and if that account is gone).
  resolvedById   String?
  resolvedBy     User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
}

// A student's dispute of one recorded no-show: why they think it is wrong, and how
// the library answered. At most one per booking, ever (the unique bookingId), open
// or answered. Overturning it puts the booking back to `released` and restores the
// points the no-show took.
model NoShowDispute {
  id             String              @id @default(uuid())
  bookingId      String              @unique
  booking        ResourceBooking     @relation(fields: [bookingId], references: [id])
  userId         String
  user           User                @relation("NoShowDisputeStudent", fields: [userId], references: [id])
  reason         String
  status         NoShowDisputeStatus @default(open)
  resolutionNote String?
  // The librarian who answered it (null while open, and if that account is gone).
  resolvedById   String?
  resolvedBy     User?               @relation("NoShowDisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
}

// A student's report of a problem with one thing: a book copy (made as the copy is
// returned) or a seat or room (made from the app). Exactly one of bookCopyId and
// resourceId is set, and a student has at most one open report per target; both
// rules are in the migration SQL (a CHECK, and two partial unique indexes
// WHERE status = 'open'), which Prisma's schema language cannot express.
model IssueReport {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation("ReportAuthor", fields: [userId], references: [id])
  bookCopyId     String?
  // A copy or resource with a report on it cannot be deleted: setting the link to
  // null would leave a report with no target (the CHECK refuses it), so the delete
  // is restricted outright. Nothing in the app deletes either; only the re-seed does.
  bookCopy       BookCopy?     @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  resourceId     String?
  resource       Resource?     @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  category       IssueCategory
  note           String?
  status         ReportStatus  @default(open)
  resolutionNote String?
  // The librarian who answered it (null while open, and if that account is gone).
  resolvedById   String?
  resolvedBy     User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
}

// One library message to one student: an overdue reminder or formal notice, or
// the outcome of a fine dispute or problem report. Written in the same
// transaction as the action that caused it; the email (if any) is attempted
// after the commit and its outcome recorded here. The student sees it in the app
// for REQUEST_OUTCOME_VISIBLE_DAYS (GET /notices/me).
model Notice {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("NoticeRecipient", fields: [userId], references: [id])
  kind        NoticeKind
  title       String
  body        String
  // The loan or fine it concerns, cleared when that row is deleted (the text is
  // already rendered, so the notice stays).
  loanId      String?
  loan        Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  fineId      String?
  fine        Fine?            @relation(fields: [fineId], references: [id], onDelete: SetNull)
  // The booking a reminder, no-show or no-show outcome notice is about, cleared
  // when that booking is deleted. The reminder is also hidden from the student's
  // list once the booking is no longer `booked` (read through this link).
  bookingId   String?
  booking     ResourceBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // The librarian whose action caused it (null if the account is gone).
  createdById String?
  createdBy   User?            @relation("NoticeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  emailStatus EmailStatus      @default(skipped)
  // When the email was attempted: set for `sent` and `failed`, null for `skipped`.
  emailedAt   DateTime?

  @@index([userId, createdAt])
}

model ReliabilityScoreLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  score        Float
  delta        Float
  reason       String
  computedAt   DateTime @default(now())
  // The librarian behind a manual adjustment (null for the automatic entries,
  // and when that account is gone).
  adjustedById String?
  adjustedBy   User?    @relation("ReliabilityAdjuster", fields: [adjustedById], references: [id], onDelete: SetNull)
}

model RecommendationCache {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  bookId      String
  book        Book                 @relation(fields: [bookId], references: [id])
  score       Float
  method      RecommendationMethod
  generatedAt DateTime             @default(now())
}
